---
interface ImageItem {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface Props {
	images: ImageItem[];
	columns?: number;
}

const { images, columns = 3 } = Astro.props;
---

<div class="photo-gallery" data-pswp-gallery style={`--gallery-columns: ${columns};`}>
	{images.map((image) => (
		<a
			href={image.src}
			data-pswp-width={image.width ?? 1200}
			data-pswp-height={image.height ?? 800}
			class="photo-gallery__item"
			aria-label={image.alt}
		>
			<img src={image.src} alt={image.alt} loading="lazy" width={image.width ?? 1200} height={image.height ?? 800} />
		</a>
	))}
</div>

<script>
import PhotoSwipeLightbox from 'photoswipe/lightbox';
import 'photoswipe/dist/photoswipe.css';

const setupPhotoSwipe = () => {
	const gallery = document.querySelector('[data-pswp-gallery]');
	if (!gallery || gallery.dataset.pswpInitialized === 'true') return;

	const lightbox = new PhotoSwipeLightbox({
		gallery: '[data-pswp-gallery]',
		children: 'a',
		pswpModule: () => import('photoswipe'),
	});

	lightbox.init();
	gallery.dataset.pswpInitialized = 'true';
};

document.addEventListener('astro:page-load', setupPhotoSwipe);

document.addEventListener('DOMContentLoaded', setupPhotoSwipe);
</script>

<style>
	.photo-gallery {
		display: grid;
		grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
		gap: 1rem;
		margin: 2rem 0;
	}

	.photo-gallery__item {
		display: block;
		overflow: hidden;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		transition: transform 0.2s ease;
	}

	.photo-gallery__item:hover {
		transform: translateY(-2px);
	}

	.photo-gallery__item img {
		display: block;
		width: 100%;
		height: 220px;
		object-fit: cover;
		border-radius: 12px;
	}

	@media (max-width: 720px) {
		.photo-gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
